# --- App Store Connect (optional — leave unset to disable Apple tools) ---
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_PRIVATE_KEY_PATH=~/.appstore/AuthKey_XXXXXXXXXX.p8

# --- Google Play (optional — leave unset to disable Play tools) ---
# Path to the service account JSON downloaded from Google Cloud Console
# (IAM → Service Accounts → Keys). The service account must be linked in
# Play Console under Users and permissions with access to your app(s).
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=~/.appstore/my-service-account.json

# --- Optional: path to the apps.json product-key mapping ---
# Defaults: ./apps.json then ~/.mcp-app-stores/apps.json
# APPS_MAPPING_PATH=~/.mcp-app-stores/apps.json
